# ===== Обязательно =====
# Токен бота от @BotFather (выглядит как 123456789:AAH...). Никому его не показывай.
BOT_TOKEN=

# ===== Доступ =====
# Кто может пользоваться ботом: Telegram ID через запятую (узнать свой ID — команда /myid в боте
# или бот @userinfobot). Пусто — бот открыт для всех, кто его найдёт.
ALLOWED_USER_IDS=

# ===== Время и сводки =====
# Часовой пояс (список: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TIMEZONE=Asia/Jerusalem
# В какой день недели присылать сводку: sun, mon, tue, wed, thu, fri, sat
SUMMARY_WEEKDAY=sun
# Во сколько присылать сводку (ЧЧ:ММ)
SUMMARY_TIME=09:00
# Во сколько записывать регулярные платежи, списания кредиток и зарплату (ЧЧ:ММ)
DAILY_JOB_TIME=08:00

# ===== Прочее =====
# Валюта по умолчанию для новых пользователей (потом меняется в ⚙️ Настройках): ₪, $, €, £, ₽
CURRENCY=₪
# Папка для данных: Excel-таблицы, реестр, резервные копии
DATA_DIR=data
# Подробность логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
